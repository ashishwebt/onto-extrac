{
  "@context": {
    "schema": "https://schema.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "ex": "https://example.com/ontology/",
    "node": "https://example.com/ontology/id#",
    "edge": "https://example.com/ontology/id#",

    "node:Company": "ex:Company",
    "node:Person": "ex:Person",
    "node:Skill": "ex:Skill",

    "worksFor": { "@id": "ex:worksFor", "@type": "@id" },
    "employs": { "@id": "ex:employs", "@type": "@id" },
    "hasSkill": { "@id": "ex:hasSkill", "@type": "@id" },
    "skillLevel": { "@id": "ex:skillLevel", "@type": "xsd:string" }
  },

  "@graph": [
    {
      "@id": "node:Company",
      "@type": "owl:Class",
      "rdfs:label": "Company",
      "rdfs:comment": "A business or organization that employs people."
    },
    {
      "@id": "node:Person",
      "@type": "owl:Class",
      "rdfs:label": "Person",
      "rdfs:comment": "A human individual who can work for a company and have skills."
    },
    {
      "@id": "node:Skill",
      "@type": "owl:Class",
      "rdfs:label": "Skill",
      "rdfs:comment": "A capability or area of knowledge."
    },
    {
      "@id": "edge:worksFor",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "worksFor",
      "rdfs:comment": "Person works for Company.",
      "rdfs:domain": { "@id": "node:Person" },
      "rdfs:range": { "@id": "node:Company" }
    },
    {
      "@id": "edge:employs",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "employs",
      "rdfs:comment": "Company employs Person.",
      "rdfs:domain": { "@id": "node:Company" },
      "rdfs:range": { "@id": "node:Person" }
    },
    {
      "@id": "edge:hasSkill",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "hasSkill",
      "rdfs:comment": "Person has Skill.",
      "rdfs:domain": { "@id": "node:Person" },
      "rdfs:range": { "@id": "node:Skill" }
    },
    {
      "@id": "edge:skillLevel",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "skillLevel",
      "rdfs:domain": { "@id": "node:Person" },
      "rdfs:range": { "@id": "xsd:string" }
    }
  ]
}
